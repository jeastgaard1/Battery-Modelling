%% ===== Auto Path Setup (DO NOT REMOVE) =====
this_file_path = fileparts(mfilename('fullpath'));

% Go up to "MATLAB Files"
matlab_files_root = fileparts(this_file_path);

% Add Main Project and all subfolders
addpath(genpath(fullfile(matlab_files_root, 'Main Project')));
addpath(genpath(fullfile(matlab_files_root, 'ECM_0D')));

clear this_file_path matlab_files_root
%% ===========================================


%% Setup output directory
output_dir = 'results';
if ~exist(output_dir, 'dir')
    mkdir(output_dir);
    fprintf('✓ Created output directory: %s\n', output_dir);
end
fprintf('✓ Results will be saved to: %s\n\n', fullfile(pwd, output_dir));

%% Load Experimental Potential Data
fprintf('Loading experimental potential data...\n');
data_file = 'Potential_Gr_Si_NMC.mat';
load(data_file);

% Extract discharge data
dch_data = param.potentials.HC.DCH;
[NMC_SoC, NMC_OCV] = clean_potential_data(dch_data.NMC_SoC, dch_data.NMC_OCV);
[Gr_SoC, Gr_OCV] = clean_potential_data(dch_data.Gr_SoC, dch_data.Gr_OCV);
[Si_SoC, Si_OCV] = clean_potential_data(dch_data.Si_SoC, dch_data.Si_OCV);
[GrSi_SoC, GrSi_OCV] = clean_potential_data(dch_data.GrSi_SoC, dch_data.GrSi_OCV);

fprintf('✓ NMC: %d points, %.3f-%.3fV\n', length(NMC_SoC), min(NMC_OCV), max(NMC_OCV));
fprintf('✓ Graphite: %d points, %.3f-%.3fV\n', length(Gr_SoC), min(Gr_OCV), max(Gr_OCV));
fprintf('✓ Silicon: %d points, %.3f-%.3fV\n', length(Si_SoC), min(Si_OCV), max(Si_OCV));
fprintf('✓ Gr/Si Composite: %d points, %.3f-%.3fV\n\n', length(GrSi_SoC), min(GrSi_OCV), max(GrSi_OCV));

%% Material Properties
rho_Si = 2.3;      % Silicon density [g/cm³]
rho_G = 2.24;      % Graphite density [g/cm³]
rho_IM = 1.1;      % Inactive materials density [g/cm³]

s_Si = 3600;       % Silicon specific capacity [mAh/g]
s_G = 330;         % Graphite specific capacity [mAh/g]
s_IM = 0;          % Inactive materials (no capacity)

e_Si = 280;        % Silicon expansion [vol-%]
e_G = 0;           % Graphite expansion (assumed negligible)
e_IM = 0;          % Inactive materials expansion

w_IM = 5;          % Inactive materials weight fraction [wt-%]

%% Silicon weight fraction range
w_Si_range = 0:0.5:95;
n_points = length(w_Si_range);

%% Calculate Average Potentials from Experimental Curves
fprintf('Calculating average potentials from experimental curves...\n');

U_avg_NMC = calculate_average_potential(NMC_SoC, NMC_OCV);
U_avg_Si = calculate_average_potential(Si_SoC, Si_OCV);
U_avg_G = calculate_average_potential(Gr_SoC, Gr_OCV);

fprintf('NMC Cathode      : %.4f V\n', U_avg_NMC);
fprintf('Silicon Anode    : %.4f V\n', U_avg_Si);
fprintf('Graphite Anode   : %.4f V\n', U_avg_G);

%% CASE STUDY 1: Zero Expansion (E=0, P_ALi=0)
fprintf('\nRunning Case Study 1: Zero Expansion...\n');

G_A_case1 = zeros(1, n_points);
V_A_case1 = zeros(1, n_points);
P_A_case1 = zeros(1, n_points);
ED_Vol_case1 = zeros(1, n_points);
U_cell_case1 = zeros(1, n_points);
U_anode_case1 = zeros(1, n_points);

for i = 1:n_points
    w_Si = w_Si_range(i);
    w_G = 100 - w_Si - w_IM;
    
    if w_G < 0, continue; end
    
    G_A_case1(i) = (w_Si * s_Si + w_G * s_G) / 100;
    
    numerator = w_Si * e_Si / rho_Si + w_G * e_G / rho_G;
    denominator = w_Si / rho_Si + w_G / rho_G + w_IM / rho_IM + ...
                  (w_Si * e_Si / rho_Si + w_G * e_G / rho_G) / 100;
    P_A_case1(i) = numerator / denominator;
    V_A_case1(i) = G_A_case1(i) * 100 / denominator;
    
    if G_A_case1(i) > 0
        U_anode_case1(i) = (w_Si * s_Si * U_avg_Si + w_G * s_G * U_avg_G) / ...
                           (w_Si * s_Si + w_G * s_G);
    else
        U_anode_case1(i) = U_avg_G;
    end
    
    U_cell_case1(i) = U_avg_NMC - U_anode_case1(i);
    ED_Vol_case1(i) = U_cell_case1(i) * V_A_case1(i);
end

target_PA = 30;
[~, idx] = min(abs(P_A_case1 - target_PA));
fprintf('At P_A = %.0f vol-%%:\n', target_PA);
fprintf('  Si content: %.1f wt-%%\n', w_Si_range(idx));
fprintf('  Volumetric capacity: %.1f mAh/cm³\n', V_A_case1(idx));
fprintf('  Gravimetric capacity: %.1f mAh/g\n', G_A_case1(idx));
fprintf('  Energy density: %.1f Wh/L\n\n', ED_Vol_case1(idx));

%% CASE STUDY 2: Constant Porosity (P_A = P_ALi, Free Expansion)
fprintf('Running Case Study 2: Constant Porosity...\n');

porosity_values = [0, 10, 20, 30, 40];
n_porosity = length(porosity_values);

V_A_case2 = zeros(n_porosity, n_points);
E_expansion = zeros(1, n_points);
ED_Vol_case2 = zeros(n_porosity, n_points);

for j = 1:n_porosity
    P_A = porosity_values(j);
    
    for i = 1:n_points
        w_Si = w_Si_range(i);
        w_G = 100 - w_Si - w_IM;
        
        if w_G < 0, continue; end
        
        G_A = G_A_case1(i);
        sum_w_rho = w_Si/rho_Si + w_G/rho_G + w_IM/rho_IM;
        sum_w_e_rho = w_Si*e_Si/(rho_Si*100) + w_G*e_G/(rho_G*100);
        
        rho_ALi = (100 - P_A) / (sum_w_rho + sum_w_e_rho);
        V_A_case2(j, i) = G_A * rho_ALi;
        ED_Vol_case2(j, i) = U_cell_case1(i) * V_A_case2(j, i);
    end
end

for i = 1:n_points
    w_Si = w_Si_range(i);
    w_G = 100 - w_Si - w_IM;
    
    if w_G < 0, continue; end
    
    sum_w_e_rho = w_Si * e_Si / rho_Si + w_G * e_G / rho_G;
    sum_w_rho = w_Si / rho_Si + w_G / rho_G + w_IM / rho_IM;
    E_expansion(i) = sum_w_e_rho / sum_w_rho;
end

fprintf('Done!\n\n');

%% ═══════════════════════════════════════════════════════════════════════
%% CURRENT DISTRIBUTION ANALYSIS (APPROACH 3: ECM + BUTLER-VOLMER)
%% ═══════════════════════════════════════════════════════════════════════
fprintf('\n');
fprintf('═══════════════════════════════════════════════════════════════\n');
fprintf('  CURRENT DISTRIBUTION ANALYSIS - APPROACH 3\n');
fprintf('  ECM Overpotential + Butler-Volmer Kinetics\n');
fprintf('═══════════════════════════════════════════════════════════════\n\n');

% Load ECM options
[options_ecm, msg_ecm] = options_ECM_VolThev;

fprintf('✓ Loaded ECM options\n');
fprintf('  Cell type: %s\n', options_ecm.cell);
fprintf('  Total capacity: %.1f Ah\n', options_ecm.anode.Qa);
fprintf('  ECM: R0=%.1f mΩ, R1=%.1f mΩ, R2=%.1f mΩ\n\n', ...
        options_ecm.ECM.R0*1000, options_ecm.ECM.R1*1000, options_ecm.ECM.R2*1000);

% Analysis parameters
C_rates = [0.5, 1.0, 2.0];
n_crates = length(C_rates);

% Si weight fractions to analyze
wtSi_detailed = [15, 30, 45, 60, 75];
n_wtSi_detailed = length(wtSi_detailed);

% Physical constants
F = 96485;
R_gas = 8.314;
T = 298.15;

% Material properties (convert to g/m³)
rho_Si_cd = rho_Si * 1e6;
rho_G_cd = rho_G * 1e6;

% Kinetic parameters
i0_Si_ref = 0.5;
i0_G_ref = 35;
alpha = 0.5;

% Particle sizes
r_Si = 100e-9;
r_G = 10e-6;

% Electrode properties
epsilon_cd = 0.35;

% Fixed total capacity
Q_total_fixed = options_ecm.anode.Qa;  % 5.5 Ah

% SOC points
SOC_points = linspace(0.95, 0.05, 100)';
n_soc = length(SOC_points);

% Interpolate OCV
OCV_Si_interp = interp1(Si_SoC, Si_OCV, SOC_points, 'linear', 'extrap');
OCV_G_interp = interp1(Gr_SoC, Gr_OCV, SOC_points, 'linear', 'extrap');

% Colors
colors_cd = [0 0.4470 0.7410; 0.8500 0.3250 0.0980; 0.9290 0.6940 0.1250];

fprintf('Current Distribution Setup:\n');
fprintf('  Fixed capacity: %.1f Ah\n', Q_total_fixed);
fprintf('  Si i0 = %.2f A/m², Gr i0 = %.2f A/m²\n', i0_Si_ref, i0_G_ref);
fprintf('  Analyzing %d Si fractions at %d C-rates\n\n', n_wtSi_detailed, n_crates);

% Storage
current_dist_results = cell(n_wtSi_detailed, 1);

%% Main Current Distribution Loop
for w_idx = 1:n_wtSi_detailed
    wtSi = wtSi_detailed(w_idx);
    wtG = 100 - wtSi - w_IM;
    
    if wtG < 0, continue; end
    
    fprintf('─────────────────────────────────────────────────────────────\n');
    fprintf('  Si %.0f wt-%% (Gr %.0f wt-%%)\n', wtSi, wtG);
    fprintf('─────────────────────────────────────────────────────────────\n');
    
    % Load ECM parameters
    wtSi_frac = wtSi / 100;
    param_ecm = ECM_Parameter_ECM_VolThev(options_ecm, wtSi_frac, );
    
    fprintf('  ✓ Loaded ECM parameters\n');
    
    % Fractions
    frac_Si = wtSi / 100;
    frac_G = wtG / 100;
    
    % Composite specific capacity
    Q_composite = frac_Si * s_Si + frac_G * s_G;  % [mAh/g]
    
    % Calculate mass required to achieve fixed capacity
    m_total = Q_total_fixed * 1000 / Q_composite;  % [g]
    
    % Use fixed capacity
    Q_total = Q_total_fixed;  % [Ah]
    
    fprintf('  Specific capacity: %.2f mAh/g\n', Q_composite);
    fprintf('  Active material mass: %.2f g\n', m_total);
    fprintf('  Total capacity: %.2f Ah (fixed)\n', Q_total);
    
    % Volumes
    V_Si = frac_Si * m_total / rho_Si_cd;
    V_G = frac_G * m_total / rho_G_cd;
    V_total = V_Si + V_G;
    
    % Surface areas
    a_Si = 3 / (rho_Si_cd * r_Si);
    a_G = 3 / (rho_G_cd * r_G);
    a_s_Si = a_Si * (V_Si / V_total) * (1 - epsilon_cd);
    a_s_G = a_G * (V_G / V_total) * (1 - epsilon_cd);
    
    % Initialize storage
    I_Si_all = zeros(n_soc, n_crates);
    I_G_all = zeros(n_soc, n_crates);
    j_Si_all = zeros(n_soc, n_crates);
    j_G_all = zeros(n_soc, n_crates);
    eta_all = zeros(n_soc, n_crates);
    R_total_all = zeros(n_soc, n_crates);
    
    % C-rate loop
    for c_idx = 1:n_crates
        C_rate = C_rates(c_idx);
        I_total = C_rate * Q_total;  % [A] - NOW CORRECT!
        
        fprintf('  C-rate %.1fC: I = %.4f A (%.0f mA)\n', ...
                C_rate, I_total, I_total*1000);
        
        % SOC loop
        for s_idx = 1:n_soc
            soc = SOC_points(s_idx);
            
            % Map SOC to time step
            t_normalized = (1 - soc) * length(options_ecm.time_span);
            t_step = max(1, min(length(options_ecm.time_span), round(t_normalized)));
            
            % Get ECM resistances
            R0 = param_ecm.R0(t_step);
            R1 = param_ecm.R1(t_step);
            R2 = param_ecm.R2(t_step);
            R_total = R0 + R1 + R2;
            
            R_total_all(s_idx, c_idx) = R_total;
            
            % APPROACH 3: Overpotential from ECM
            eta = I_total * R_total;
            eta_all(s_idx, c_idx) = eta;
            
            % SOC-dependent exchange currents
            c_factor = sqrt(soc * (1 - soc) + 0.01);
            i0_Si_eff = i0_Si_ref * c_factor;
            i0_G_eff = i0_G_ref * c_factor;
            
            % Butler-Volmer
            BV_term = exp(alpha * F * eta / (R_gas*T)) - ...
                      exp(-(1-alpha) * F * eta / (R_gas*T));
            
            j_Si = i0_Si_eff * BV_term;
            j_G = i0_G_eff * BV_term;
            
            j_Si_all(s_idx, c_idx) = j_Si;
            j_G_all(s_idx, c_idx) = j_G;
            
            % Total currents
            I_Si = j_Si * a_s_Si * V_total;
            I_G = j_G * a_s_G * V_total;
            
            % Normalize
            scale = I_total / (I_Si + I_G);
            I_Si = I_Si * scale;
            I_G = I_G * scale;
            
            I_Si_all(s_idx, c_idx) = I_Si;
            I_G_all(s_idx, c_idx) = I_G;
        end
        
        % Summary
        avg_frac_Si = mean(I_Si_all(:, c_idx)) / I_total * 100;
        fprintf('    → Si: %.2f%%, Gr: %.2f%%\n', avg_frac_Si, 100-avg_frac_Si);
    end
    
    % Calculate derived quantities
    frac_Si_current = (I_Si_all ./ (I_Si_all + I_G_all)) * 100;
    frac_G_current = (I_G_all ./ (I_G_all + I_G_all)) * 100;
    ratio_current = I_Si_all ./ I_G_all;
    
    % Store results
    results_wtSi.wtSi = wtSi;
    results_wtSi.SOC = SOC_points;
    results_wtSi.I_Si = I_Si_all;
    results_wtSi.I_G = I_G_all;
    results_wtSi.j_Si = j_Si_all;
    results_wtSi.j_G = j_G_all;
    results_wtSi.eta = eta_all;
    results_wtSi.R_total = R_total_all;
    results_wtSi.frac_Si = frac_Si_current;
    results_wtSi.frac_G = frac_G_current;
    results_wtSi.ratio = ratio_current;
    results_wtSi.OCV_Si = OCV_Si_interp;
    results_wtSi.OCV_G = OCV_G_interp;
    results_wtSi.Q_total = Q_total;
    
    current_dist_results{w_idx} = results_wtSi;
    
    % SIMPLE PLOT - Just one clean plot!
    plot_current_distribution_simple(results_wtSi, C_rates, output_dir);
    
    % Export CSV
    export_current_distribution_csv(results_wtSi, C_rates, output_dir);
    
    fprintf('  ✓ Saved results\n\n');
end

fprintf('═══════════════════════════════════════════════════════════════\n');
fprintf('  CURRENT DISTRIBUTION COMPLETE\n');
fprintf('═══════════════════════════════════════════════════════════════\n\n');

%% PLOTTING - ORIGINAL CASE STUDIES
fprintf('Creating case study plots...\n');

%% Plot 1: Case Study 1
fig1 = figure('Position', [100, 100, 1200, 800]);
set(fig1, 'Color', 'w');

yyaxis left
plot(w_Si_range, V_A_case1, 'r-', 'LineWidth', 2.5, 'DisplayName', 'V_A (Si/Graphite)');
hold on;
plot(w_Si_range, G_A_case1, 'g-', 'LineWidth', 2.5, 'DisplayName', 'G_A (Si/Graphite)');
ylabel('Specific Capacity (V_A in mAh/cm³ & G_A in mAh/g)', 'FontWeight', 'bold', 'FontSize', 12);
ylim([0, 3500]);
set(gca, 'YColor', 'k');

yyaxis right
plot(w_Si_range, P_A_case1, 'b-', 'LineWidth', 2.5, 'DisplayName', 'P_A (Si/Graphite)');
ylabel('Initial electrode porosity P_A (vol-%)', 'FontWeight', 'bold', 'FontSize', 12, 'Color', 'b');
ylim([0, 100]);
set(gca, 'YColor', 'b');

yyaxis right
yline(30, 'k--', 'LineWidth', 1.5, 'Alpha', 0.7);
xline(w_Si_range(idx), 'k--', 'LineWidth', 1.5, 'Alpha', 0.7);
plot(w_Si_range(idx), 30, 'ko', 'MarkerSize', 8, 'MarkerFaceColor', 'w', 'LineWidth', 2);

yyaxis left
plot(w_Si_range(idx), V_A_case1(idx), 'ks', 'MarkerSize', 10, 'MarkerFaceColor', 'k', 'LineWidth', 2);

xlabel('Silicon w_{Si} amount (wt-%)', 'FontWeight', 'bold', 'FontSize', 12);
title('Case-Study 1: Zero Expansion (E=0 & P_{ALi}=0)', 'FontWeight', 'bold', 'FontSize', 14);
legend('Location', 'northwest', 'FontSize', 10);
grid on;
set(gca, 'FontSize', 11);

saveas(fig1, fullfile(output_dir, 'case1_experimental.png'));
fprintf('✓ Case 1 plot saved\n');

%% Plot 2: Case Study 2
fig2 = figure('Position', [150, 150, 1200, 800]);
set(fig2, 'Color', 'w');

colors_porosity = lines(n_porosity);

yyaxis left
for j = 1:n_porosity
    plot(w_Si_range, V_A_case2(j, :), '-', 'Color', colors_porosity(j, :), ...
         'LineWidth', 2.5, 'DisplayName', sprintf('Porosity %d%%', porosity_values(j)));
    hold on;
end
ylabel('Volumetric capacity V_A (mAh/cm³)', 'FontWeight', 'bold', 'FontSize', 12);
ylim([0, 2400]);
set(gca, 'YColor', 'k');

yyaxis right
plot(w_Si_range, E_expansion, 'b-', 'LineWidth', 3, 'DisplayName', 'Expansion tolerance factor');
ylabel('Expansion Tolerance E (vol-%)', 'FontWeight', 'bold', 'FontSize', 12, 'Color', 'b');
ylim([0, 260]);
set(gca, 'YColor', 'b');

xlabel('Silicon w_{Si} amount (wt-%)', 'FontWeight', 'bold', 'FontSize', 12);
title('Case-Study 2: Constant Porosity (P_A = P_{ALi})', 'FontWeight', 'bold', 'FontSize', 14);
legend('Location', 'best', 'FontSize', 10);
grid on;
set(gca, 'FontSize', 11);

saveas(fig2, fullfile(output_dir, 'case2_experimental.png'));
fprintf('✓ Case 2 plot saved\n');

fprintf('\n✓✓✓ ALL ANALYSES COMPLETE! ✓✓✓\n');
fprintf('Check the "%s" folder for results.\n', output_dir);

%% ═══════════════════════════════════════════════════════════════════════
%% HELPER FUNCTIONS
%% ═══════════════════════════════════════════════════════════════════════

function [SoC_clean, OCV_clean] = clean_potential_data(SoC_raw, OCV_raw)
    SoC = SoC_raw(:);
    OCV = OCV_raw(:);
    valid_idx = (SoC >= 0) & (SoC <= 1) & (OCV >= 0) & (OCV <= 5);
    SoC_clean = SoC(valid_idx);
    OCV_clean = OCV(valid_idx);
end

function U_avg = calculate_average_potential(SoC, OCV)
    if isempty(SoC) || isempty(OCV)
        U_avg = 0;
        return;
    end
    SoC = SoC(:);
    OCV = OCV(:);
    integral_V = trapz(SoC, OCV);
    delta_SoC = SoC(end) - SoC(1);
    if delta_SoC > 0
        U_avg = integral_V / delta_SoC;
    else
        U_avg = mean(OCV);
    end
end

function plot_current_distribution_simple(results, C_rates, output_dir)
    % Simple, clean plot showing current distribution
    
    fig = figure('Position', [100, 100, 1000, 700]);
    set(fig, 'Color', 'w');
    
    wtSi = results.wtSi;
    SOC = results.SOC;
    n_rates = length(C_rates);
    
    colors = [0 0.4470 0.7410; 0.8500 0.3250 0.0980; 0.9290 0.6940 0.1250];
    
    hold on;
    
    % Plot Graphite (solid lines)
    for c = 1:n_rates
        plot(SOC*100, results.I_G(:,c)*1000, '-', ...
             'LineWidth', 3, 'Color', colors(c,:), ...
             'DisplayName', sprintf('Gr %.1fC', C_rates(c)));
    end
    
    % Plot Silicon (dashed lines)
    for c = 1:n_rates
        plot(SOC*100, results.I_Si(:,c)*1000, '--', ...
             'LineWidth', 3, 'Color', colors(c,:), ...
             'DisplayName', sprintf('Si %.1fC', C_rates(c)));
    end
    
    xlabel('State of Charge [%]', 'FontSize', 14, 'FontWeight', 'bold');
    ylabel('Current [mA]', 'FontSize', 14, 'FontWeight', 'bold');
    title(sprintf('Current Distribution: Si %.0f wt-%%', wtSi), ...
          'FontSize', 16, 'FontWeight', 'bold');
    
    legend('Location', 'best', 'FontSize', 12);
    grid on;
    box on;
    set(gca, 'FontSize', 12, 'LineWidth', 1.5);
    ax = gca;
    ax.Toolbar.Visible = 'off';
    saveas(fig, fullfile(output_dir, sprintf('current_dist_simple_Si%.0f.png', wtSi)));
    % Optional: auto-arrange figures on screen (MATLAB built-in way)
    figs = findall(0, 'Type', 'figure');
    n = numel(figs);
    cols = ceil(sqrt(n));
    rows = ceil(n/cols);

    screen = get(0, 'ScreenSize');
    w = screen(3)/cols;
    h = screen(4)/rows;

    for k = 1:n
        row = floor((k-1)/cols);
        col = mod((k-1), cols);
        set(figs(k), 'Position', [col*w, screen(4)-(row+1)*h, w, h]);
    end
    end

function export_current_distribution_csv(results, C_rates, output_dir)
    wtSi = results.wtSi;
    
    for c = 1:length(C_rates)
        T = table(results.SOC*100, ...
                 results.I_Si(:,c)*1000, results.I_G(:,c)*1000, ...
                 results.frac_Si(:,c), results.frac_G(:,c), ...
                 results.j_Si(:,c), results.j_G(:,c), ...
                 results.eta(:,c)*1000, results.R_total(:,c)*1000, ...
                 results.ratio(:,c), results.OCV_Si, results.OCV_G, ...
                 'VariableNames', {'SOC_pct', 'I_Si_mA', 'I_Gr_mA', ...
                                  'Si_frac_pct', 'Gr_frac_pct', ...
                                  'j_Si_A_m2', 'j_Gr_A_m2', ...
                                  'eta_mV', 'R_tot_mOhm', ...
                                  'I_ratio', 'OCV_Si_V', 'OCV_Gr_V'});
        
        filename = fullfile(output_dir, sprintf('current_dist_Si%.0f_C%.1f.csv', wtSi, C_rates(c)));
        writetable(T, filename);
    end
end

