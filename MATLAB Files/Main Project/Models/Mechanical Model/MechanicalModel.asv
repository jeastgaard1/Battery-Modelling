%% Advanced Mechanical Model: Si-Gr Composite Anode (NMC Cell)
% Fixed indexing for numeric matrices and integrated experimental CSVs

clear; clc; close all;

%% 1. Configuration & User Inputs
Si_wt_percent = 15;          % ADJUST: Silicon weight % in active material
Gr_wt_percent = 85;          % ADJUST: Graphite weight % in active material
BoundaryCondition = 'fixed'; % Options: 'fixed' or 'free'
Cycle = 'discharge'; % Options: 'charge' or 'discharge'

% Initial Geometry (Adjust based on your specific cell design)
d0_anode = 65e-6;            % Anode thickness [m]
d0_cathode = 55e-6;          % Cathode thickness [m]
d0_sep = 12e-6;              % Separator thickness [m]
Area = 0.012;                % Electrode Area [m^2]

% Mechanical Stiffness (E-Moduli in Pa)
E_anode = 12e9; 
E_cathode = 25e9; 
E_sep = 1.2e9; 

%% 2. Load and Process Data (Robust Multi-Version Version)
load('mechanicalProperties.mat'); 

% This function converts the structure values to a cell array and then a matrix.
% It works regardless of whether the fields are named 'f1', 'x', or 'Var1'.
extractData = @(s) cell2mat(struct2cell(s)');

if strcmp(Cycle, 'charge')

% Define the simulation SoC range
SoC_sim = linspace(0, 1, 200)';
% 1. Extract Silicon (SiO_Ch) 
% Using -1 because data starts at 1.0 (V/V0)
si_raw  = extractData(mech.SiO_Ch);
exp_Si  = interp1(si_raw(:,1), si_raw(:,2)-1, SoC_sim, 'linear', 'extrap');

% 2. Extract Graphite (Gr_Ch)
gr_raw  = extractData(mech.Gr_Ch);
exp_Gr  = interp1(gr_raw(:,1), gr_raw(:,2), SoC_sim, 'linear', 'extrap');

% 3. Extract Cathode (NMC_Dch)
nmc_raw = extractData(mech.NMC_Ch);
exp_NMC = interp1(nmc_raw(:,1), nmc_raw(:,2), SoC_sim, 'linear', 'extrap');
else

% Define the simulation SoC range
SoC_sim = linspace(1, 0, 200)';
% 1. Extract Silicon (SiO_Ch) 
% Using -1 because data starts at 1.0 (V/V0)
si_raw  = extractData(mech.SiO_Dch);
exp_Si  = interp1(si_raw(:,1), si_raw(:,2)-1, SoC_sim, 'linear', 'extrap');

% 2. Extract Graphite (Gr_Ch)
gr_raw  = extractData(mech.Gr_Dch);
exp_Gr  = interp1(gr_raw(:,1), gr_raw(:,2), SoC_sim, 'linear', 'extrap');

% 3. Extract Cathode (NMC_Dch)
nmc_raw = extractData(mech.NMC_Dch);
exp_NMC = interp1(nmc_raw(:,1), nmc_raw(:,2), SoC_sim, 'linear', 'extrap');
end

% 4. Load reference experimental data from your CSVs
anode_exp = readtable('Dilatometer_Anode.xlsx');
cathode_exp = readtable('Dilatometer_Cathode.xlsx');

%% 3. Calculate Composite Expansion
exp_anode_total = (Si_wt_percent/100)*exp_Si + (Gr_wt_percent/100)*exp_Gr;

% Total SOC expansion
delta_L_free_anode = d0_anode * exp_anode_total;
delta_L_free_cathode = d0_cathode * exp_NMC; % Updated name
delta_L_total = delta_L_free_anode + delta_L_free_cathode;

% Total Thermal Expansion


% Total free thickness change (unconstrained)


%% 4. Calculate Stress and Strain (Rheological Model)
% Total cell compliance (Serial connection of springs: d/EA)
Compliance_cell = (d0_anode/(E_anode*Area)) + (d0_cathode/(E_cathode*Area)) + (d0_sep/(E_sep*Area));

if strcmp(BoundaryCondition, 'fixed')
    % FIXED: Total thickness change is suppressed, generating stress
    Force = delta_L_total / Compliance_cell;
    Stress = Force / Area; % Result in Pascals [Pa]
    Strain_cell = zeros(size(SoC_sim));
elseif strcmp(BoundaryCondition, 'free')
    Stress = zeros(size(SoC_sim));
    Strain_cell = delta_L_total / (d0_anode + d0_cathode + d0_sep);
    el
end

% Porosity Calculation (Volume conservation)
phi_0 = 0.35; % Initial porosity (35%)
V_pore_0 = d0_anode * Area * phi_0;
V_solid_growth = delta_L_free_anode * Area;
% In a fixed boundary, growth consumes pore volume
New_Porosity = (V_pore_0 - V_solid_growth) / (d0_anode * Area);

%% 5. Visualization
figure('Color', 'w', 'Position', [100 100 1100 800]);

sgtitle(Cycle); 
% Subplot 1: Anode Strain vs. Experimental
subplot(2,2,1);
plot(SoC_sim*100, exp_anode_total*100, 'b', 'LineWidth', 2.5); hold on;

plot(anode_exp.SoC_Li*100, (anode_exp.Thickness_Li*1e-6 / d0_anode)*100, '--k');
title(['Anode Strain (', num2str(Si_wt_percent), '% Silicon)']);
ylabel('Strain [%]'); xlabel('SoC [%]'); grid on; 
legend('Si/Gr Model', 'Samsung data', 'Location', 'best');

% Subplot 2: Internal Stress
subplot(2,2,2);
plot(SoC_sim*100, Stress/1e6, 'r', 'LineWidth', 2.5);
title(['Internal Cell Stress (', BoundaryCondition, ')']);
ylabel('Stress [MPa]'); grid on;

% Subplot 3: Porosity
subplot(2,2,3);
plot(SoC_sim*100, New_Porosity*100, 'g', 'LineWidth', 2.5);
title('Anode Porosity Evolution');
xlabel('State of Charge [%]'); ylabel('Porosity [%]'); grid on;
yline(0, '--r', 'Pores Exhausted'); % Critical threshold

% Subplot 4: Total Cell Thickening
subplot(2,2,4);
plot(SoC_sim*100, delta_L_total*1e6, 'm', 'LineWidth', 2.5);
title('Potential Total Cell Thickening');
xlabel('State of Charge [%]'); ylabel('\Delta L [\mu m]'); grid on;

fprintf('Simulation Complete.\nMax Stress: %.2f MPa\nFinal Porosity: %.2f%%\n', max(Stress/1e6), New_Porosity(end)*100);